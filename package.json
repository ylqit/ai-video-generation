{
  "name": "series-video-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,worker,web \"tsx watch src/server/main.ts\" \"tsx watch src/server/worker-main.ts\" \"vite --host 127.0.0.1\"",
    "build": "vue-tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "typecheck": "vue-tsc --noEmit",
    "format:check": "prettier --check src scripts tests package.json tsconfig*.json vite.config.ts",
    "start": "concurrently -k -n api,worker \"node dist/server/server/main.js\" \"node dist/server/server/worker-main.js\"",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "backup": "tsx scripts/backup.ts",
    "doctor": "tsx scripts/doctor.ts",
    "migrate:models": "tsx scripts/migrate-models.ts",
    "migrate:voices": "tsx scripts/migrate-voices.ts",
    "migrate:free-creation": "tsx scripts/migrate-free-creation.ts",
    "retain:workspace": "tsx scripts/retain-workspace.ts"
  },
  "dependencies": {
    "@openai/codex": "0.154.0",
    "@vue-flow/core": "^1.48.2",
    "esbuild": "0.28.2",
    "express": "^5.2.1",
    "multer": "^2.0.2",
    "three": "0.186.0",
    "vue": "^3.5.12",
    "ws": "^8.18.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/three": "0.186.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vue-tsc": "^3.2.4"
  }
}
