{
  "UNETLoader": {
    "output": ["MODEL"],
    "input": {
      "required": {
        "unet_name": [
          [
            "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
            "minimax_h3_ref2va_pruned_int8_convrot.safetensors"
          ]
        ],
        "weight_dtype": [
          ["default", "fp8_e4m3fn", "fp8_e4m3fn_fast", "fp8_e5m2"],
          {
            "advanced": true
          }
        ]
      }
    }
  },
  "CLIPLoader": {
    "output": ["CLIP"],
    "input": {
      "required": {
        "clip_name": [["qwen3vl_32b_minimax_h3_int4_convrot.safetensors"]],
        "type": [
          [
            "stable_diffusion",
            "stable_cascade",
            "sd3",
            "stable_audio",
            "mochi",
            "ltxv",
            "pixart",
            "cosmos",
            "lumina2",
            "wan",
            "hidream",
