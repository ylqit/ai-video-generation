  "BasicScheduler": {
    "output": ["SIGMAS"],
    "input": {
      "required": {
        "model": ["MODEL", {}],
        "scheduler": [
          "COMBO",
          {
            "multiselect": false,
            "options": [
              "simple",
              "sgm_uniform",
              "karras",
              "exponential",
              "ddim_uniform",
              "beta",
              "normal",
              "linear_quadratic",
              "kl_optimal"
            ]
          }
        ],
        "steps": [
          "INT",
          {
            "default": 20,
            "min": 1,
            "max": 10000
          }
        ],
        "denoise": [
          "FLOAT",
          {
            "default": 1.0,
            "min": 0.0,
            "max": 1.0,
            "step": 0.01
          }
        ]
      }
    }
  },
  "RandomNoise": {
    "output": ["NOISE"],
    "input": {
      "required": {
        "noise_seed": [
          "INT",
          {
            "default": 0,
            "min": 0,
            "max": 18446744073709551615,
            "control_after_generate": true
          }
        ]
      }
    }
